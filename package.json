{
  "name": "recon-agent",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "gen": "bun run scripts/generate-data.ts",
    "gen:holdout": "bun run scripts/generate-data.ts --out data/holdout --seed 777",
    "gen:hard": "bun run scripts/generate-data.ts --out data/hard --seed 999 --mode hard",
    "fetch-benchrec": "bun run scripts/fetch-benchrec.ts",
    "pipeline": "bun run src/pipeline/run.ts",
    "pipeline:hard": "bun run src/pipeline/run.ts --data data/hard --out results/hard-run.json --no-ai",
    "pipeline:hard:ai": "bun run src/pipeline/run.ts --data data/hard --out results/hard-run.json",
    "eval": "bun run scripts/eval.ts",
    "eval:holdout": "bun run scripts/eval.ts --data data/holdout --results results/holdout-run.json",
    "eval:hard": "bun run scripts/eval.ts --data data/hard --results results/hard-run.json",
    "loop-eval": "bun run scripts/loop-eval.ts",
    "error-analysis": "bun run scripts/error-analysis.ts",
    "cross-validate": "bun run scripts/cross-validate.ts",
    "cross-validate:full": "bun run scripts/cross-validate.ts --seeds 7",
    "gen:adversarial": "bun run scripts/generate-adversarial.ts",
    "pipeline:adversarial": "bun run src/pipeline/run.ts --data data/adversarial --out results/adversarial-run.json",
    "showcase:agent": "bun run scripts/run-agent-showcase.ts",
    "build:ui": "cd client && bun run build",
    "dev:ui": "cd client && bun run dev",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.50",
    "@ai-sdk/openai-compatible": "^3.0.40",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "ai": "7.0.83",
    "decimal.js": "10.6.0",
    "fastest-levenshtein": "1.0.16",
    "fflate": "0.8.3",
    "hono": "4.13.5",
    "p-limit": "7.3.1",
    "papaparse": "5.7.0",
    "razorpay": "^2.9.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/papaparse": "5.5.2"
  }
}
