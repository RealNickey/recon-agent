{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Bash(cat:*.env*)",
      "Bash(type:*.env*)",
      "Bash(Get-Content:*.env*)",
      "Bash(echo $env:GROUND_TRUTH_PATH)",
      "Bash(echo $env:OPENROUTER_API_KEY)",
      "Bash(gci env:*)",
      "Bash(Get-ChildItem env:*)",
      "Bash(ls env:*)",
      "Bash(printenv*)",
      "Bash(set)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Write(./.env)",
      "Write(./.env.*)"
    ]
  }
}
